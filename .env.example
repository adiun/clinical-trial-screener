# TypeSafe API key. Server-side only; never sent to the browser.
TYPESAFE_API_KEY=

# Set to true to use a fake Jev client with 70-500ms jitter (no quota used).
MOCK_JEV=false
# Mock only: fraction of calls that fail with a simulated 429, to exercise back-off. Default 0.
MOCK_JEV_429_RATE=0

# Bounded concurrency for the per-note fan-out. Default 50 live, 160 in mock mode.
JEV_CONCURRENCY=

# Jev model alias or pinned version. Default jev-latest.
JEV_MODEL=jev-latest

# Server port. Default 8787.
PORT=8787
